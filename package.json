{
  "name": "backbit",
  "version": "1.0.0",
  "description": "Backbit monorepo",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"pnpm --filter web dev\" \"pnpm --filter api start:dev\"",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "pnpm --filter api format",
    "format:check": "pnpm --filter api exec prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
